{
  "_comment": "Maps Figma token names to semantic design token aliases",
  "_description": "This file creates semantic aliases for design tokens extracted from Figma. Use this to maintain a consistent naming convention between Figma variables and your design system's token names.",
  "aliases": {
    "colors": {
      "figma/gray/50": "surface",
      "figma/gray/100": "surfaceSubdued",
      "figma/gray/300": "border",
      "figma/gray/500": "textDisabled",
      "figma/gray/700": "textSecondary",
      "figma/gray/900": "textPrimary",
      "figma/blue/500": "interactive",
      "figma/green/500": "success",
      "figma/red/500": "critical",
      "figma/yellow/300": "warning"
    },
    "typography": {
      "figma/size/xs": "fontSize100",
      "figma/size/sm": "fontSize200",
      "figma/size/base": "fontSize300",
      "figma/size/lg": "fontSize400",
      "figma/size/xl": "fontSize600",
      "figma/size/2xl": "fontSize700",
      "figma/size/3xl": "fontSize900"
    },
    "shadows": {
      "figma/shadow/xs": "shadowXs",
      "figma/shadow/sm": "shadowSm",
      "figma/shadow/md": "shadowMd",
      "figma/shadow/lg": "shadowLg",
      "figma/shadow/button-default": "shadowButton"
    }
  }
}
